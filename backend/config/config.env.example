# Copy this file to config.env and fill in real values.
# NEVER commit config.env — it is gitignored.

# Port the server listens on
PORT=3000

# DEVELOPMENT or PRODUCTION
NODE_ENV=DEVELOPMENT

# MongoDB connection string (e.g. mongodb://127.0.0.1:27017/agrilink or a MongoDB Atlas URI)
DB_URI=mongodb://127.0.0.1:27017/agrilink

# Secret used to sign JWTs — use a long random string
JWT_SECRET=change_me_to_a_long_random_secret

# JWT lifetime, e.g. 7d
JWT_EXPIRES_TIME=7d

# Cookie lifetime in days
COOKIE_EXPIRES_TIME=7
