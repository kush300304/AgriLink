{
  "name": "agrilink",
  "version": "1.0.0",
  "description": "A marketplace that connects farmers directly with verified buyers and surfaces fair, MSP-based crop prices.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watch",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "agriculture",
    "marketplace",
    "express",
    "mongodb",
    "ejs",
    "nodejs"
  ],
  "author": "Kushal Garg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kush300304/AgriLink.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^0.26.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.2",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.6",
    "express": "^4.17.3",
    "helmet": "^5.0.2",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.21",
    "mongoose": "^6.2.2",
    "nodemailer": "^6.7.2",
    "validator": "^13.7.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  }
}
