{
  "root": true,
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended", "prettier"],
  "rules": {
    "no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["public/assets/js/**/*.js"],
      "env": { "browser": true },
      "rules": { "no-unused-vars": "off", "no-undef": "off" }
    },
    {
      "files": ["public/javascript/**/*.js"],
      "env": { "browser": true },
      "rules": {
        "no-unused-vars": "off",
        "no-undef": "off",
        "no-useless-escape": "off"
      }
    }
  ]
}
